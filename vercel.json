{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:app/app-ads.txt",
      "destination": "/app-ads.txt",
      "permanent": true
    },
    {
      "source": "/harmonify/:path*",
      "destination": "/aura-music-player/:path*",
      "permanent": true
    },
    {
      "source": "/cinemora/:path*",
      "destination": "/cinematic-pro/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
